{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "go build*": "allow",
      "go vet*": "allow",
      "go test*": "allow",
      "go generate*": "allow",
      "go run cmd/populate*": "allow",
      "make *": "allow",
      "make clean": "deny",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "npx svelte-check*": "allow",
      "sqlite3 pb_data/*": "allow"
    }
  }
}

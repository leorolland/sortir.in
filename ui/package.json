{
  "name": "sk",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:backend": "cd ../pb && modd",
    "backend": "AUDITLOG=users,posts ../pb/entrypoint.sh ./pocketbase serve --publicDir=../sk/build",
    "backend:windows": "cd ../pb && set \"RELEASE=standard\" && entrypoint.bat pocketbase.exe serve --publicDir=../sk/build",
    "build": "vite build",
    "build:backend": "cd ../pb && go build",
    "typegen": "pocketbase-typegen --db ../pb_data/data.db --out ./src/lib/pocketbase/generated-types.ts",
    "test": "playwright test",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.1.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/geojson": "^7946.0.16",
    "pocketbase-typegen": "^1.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "sass": "^1.104.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "type": "module",
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "geojson": "^0.5.0",
    "maplibre-gl": "^5.24.0",
    "pocketbase": "^0.26.9",
    "svelte-maplibre": "^1.3.0",
    "zod": "^3.25.76"
  }
}
